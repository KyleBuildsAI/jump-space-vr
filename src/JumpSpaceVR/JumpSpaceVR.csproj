<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>JumpSpaceVR</AssemblyName>
    <RootNamespace>JumpSpaceVR</RootNamespace>
    <Version>0.3.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <MelonLoaderPath>$(GamePath)\MelonLoader</MelonLoaderPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(MelonLoaderPath)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MelonLoaderPath)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MelonLoaderPath)\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(MelonLoaderPath)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(MelonLoaderPath)\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

</Project>
